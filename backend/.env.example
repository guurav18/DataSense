# ==============================================================================
# DataSense AI - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env in the backend directory and update with your values:
#   cp .env.example .env
# NOTE: Do NOT commit your actual .env file with secrets into version control.

# Application Settings
APP_NAME="DataSense AI"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated URLs for the frontend)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL with psycopg3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/datasense_ai

# LLM Configuration (Configurable for LangGraph Agent)
# Supported providers: openai, anthropic, google_genai, etc.
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Storage Directories
UPLOAD_DIR=./uploads
CHARTS_DIR=./generated_charts
